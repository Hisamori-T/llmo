[Unit]
Description=LLMO Score Backend (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/llmo/backend
ExecStart=/root/llmo/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8005 --workers 2
Restart=always
RestartSec=5
EnvironmentFile=/root/llmo/backend/.env

[Install]
WantedBy=multi-user.target
